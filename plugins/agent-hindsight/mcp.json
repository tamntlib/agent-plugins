{
  "mcpServers": {
    "hindsight": {
      "type": "stdio",
      "command": "node",
      "args": [
        "-e",
        "import('node:path').then(p => import('node:url').then(u => import(u.pathToFileURL(p.resolve(process.env.PLUGIN_ROOT || '.', 'scripts', 'mcp.mjs')).href)))"
      ]
    }
  }
}
